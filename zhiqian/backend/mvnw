#!/bin/sh
# Maven Wrapper script
# Downloads Maven if not present

MAVEN_HOME="$HOME/.m2/wrapper/dists/apache-maven-3.9.9"
MAVEN_URL="https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/3.9.9/apache-maven-3.9.9-bin.zip"

if [ ! -d "$MAVEN_HOME" ]; then
    echo "Downloading Maven 3.9.9..."
    mkdir -p "$MAVEN_HOME"
    curl -L --insecure -o "$MAVEN_HOME/maven.zip" "$MAVEN_URL"
    cd "$MAVEN_HOME" && unzip -q maven.zip && rm maven.zip
fi

exec "$MAVEN_HOME/apache-maven-3.9.9/bin/mvn" "$@"
