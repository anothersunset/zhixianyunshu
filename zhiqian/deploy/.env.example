# ============================================================
# 智迁云枢 deploy/.env.example
# 用法: cp .env.example .env 后逐项修改。.env 已被 .gitignore 忽略，切勿提交。
# 变量清单与同目录 docker-compose.yml 一一对应：
#   - 【必填】变量在 compose 中使用 ${VAR:?} 语法，缺失时 docker compose 直接报错退出
#   - 其余变量在 compose 中均有默认值（${VAR:-default}），可按需覆盖
# 本文件所有取值均为占位符，不含任何真实密钥
# ============================================================

# ===== 必填（docker-compose.yml 强制校验）=====
# Postgres 账号 zhiqian 的密码；同一变量供 backend 数据源与 Temporal 初始化使用
POSTGRES_PASSWORD=change-me-strong-db-password
# JWT 签名密钥（compose 内透传为 backend 的 APP_JWT_SECRET），请用至少 32 字符随机串
JWT_SECRET=change-me-random-string-at-least-32-chars
# 内置管理员账号的初始密码（透传为 APP_ADMIN_PASSWORD，首次启动时引导创建）
ADMIN_PASSWORD=change-me-admin-initial-password

# ===== 可选：LLM（compose 默认 DeepSeek；LLM_API_KEY 留空时 backend 走确定性降级，不调真实 LLM）=====
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_CHAT_MODEL=deepseek-chat
LLM_REASONER_MODEL=deepseek-reasoner
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60
LLM_THINKING_ENABLED=true
LLM_REASONING_EFFORT=high

# ===== 可选：Temporal 持久化工作流（compose 默认 false）=====
# 启用方式：TEMPORAL_ENABLED=true 且 docker compose --profile temporal up -d
TEMPORAL_ENABLED=false
TEMPORAL_TARGET=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=zhiqian-migration

# ===== 可选：Langfuse 全链路观测（三个变量 compose 内置默认；两把 key 留空即 disabled）=====
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ===== 可选：RAG 模型构建与挂载 =====
# 1 = 构建镜像时下载 ML 依赖（镜像显著变大）；0 = 运行时挂载模型目录
RAG_BUILD_ML=0
# RAG_USE_BGE_M3 / RAG_USE_RERANKER 开关；模型路径默认是容器内挂载点
# （compose 把宿主机 ${HF_CACHE_DIR}/modelscope/BAAI/... 只读挂载到 /models/...）
RAG_USE_BGE_M3=true
RAG_BGE_MODEL=/models/bge-m3
RAG_BGE_FP16=true
RAG_USE_RERANKER=true
RAG_RERANKER_MODEL=/models/bge-reranker-v2-m3
RAG_RERANKER_FP16=true
RAG_EMBEDDING_DIM=1024
# HuggingFace 镜像端点（国内加速）
HF_ENDPOINT=https://hf-mirror.com
# 宿主机模型缓存根目录。注意：compose 的默认值指向开发机的 Windows 绝对路径，
# 在其他机器部署时必须改成你的本机缓存目录，否则模型目录挂载为空，rag 无法加载 BGE-M3 / reranker
HF_CACHE_DIR=/absolute/path/to/your/hf_cache

# ===== 可选：Qdrant 向量库 =====
RAG_USE_QDRANT=true
RAG_QDRANT_URL=http://qdrant:6333
# 本 compose 的 qdrant 服务未开启鉴权，留空即可；对接带 API Key 的外部 Qdrant 时再填
RAG_QDRANT_API_KEY=
RAG_RRF_K=60

# ===== 可选：分块策略（semantic / late / none）=====
RAG_CHUNK_STRATEGY=semantic
RAG_CHUNK_SIM_THRESHOLD=0.62
RAG_CHUNK_MAX_CHARS=1200
RAG_LATE_CHUNK_MAX_CHARS=600
RAG_LATE_CHUNK_OVERLAP=80

# ===== 注意：以下变量 docker-compose.yml 当前并未读取 =====
# 历史 .env / 文档中出现过，为避免误解特此说明（修改行为请直接编辑 compose 文件）：
# - POSTGRES_USER / POSTGRES_DB：compose 中固定为 zhiqian / zhiqian，不从 .env 读取
# - JWT_TTL_MINUTES：backend 实际读取 APP_JWT_TTL_MINUTES（默认 60），且 compose 未透传
# - WEB_HOST_PORT / BACKEND_HOST_PORT / RAG_HOST_PORT / POSTGRES_HOST_PORT：
#   端口映射直接写在 compose 里（web 80、backend 8080、rag 8001、qdrant 6333/6334、
#   postgres 未对宿主机暴露），不存在 *_HOST_PORT 变量
